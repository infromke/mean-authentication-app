{
  "name": "auth-server",
  "description": "API Node.js para criação e autenticação de usuários",
  "version": "2.1.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch ./src/server.ts",
    "build": "tsc",
    "start": "node ./dist/server.js",
    "start:local": "node --env-file=.env ./dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "5.2.1",
    "express-rate-limit": "8.2.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.20.1",
    "morgan": "1.10.1",
    "node-cache": "5.1.2",
    "nodemailer": "7.0.11",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "25.8.0",
    "@types/nodemailer": "8.0.0",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
